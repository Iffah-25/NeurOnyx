{
  "entities": {
    "Form": {
      "title": "Form",
      "description": "Represents a dynamic form structure created by an admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fields": { "type": "array" },
        "slug": { "type": "string" },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "limitOneResponse": { "type": "boolean" },
        "restrictToDomain": { "type": "boolean" },
        "successMessage": { "type": "string" },
        "headerImage": { "type": "string" },
        "theme": { "type": "object" }
      },
      "required": ["title", "fields", "slug", "createdAt", "createdBy"]
    },
    "Response": {
      "title": "Response",
      "description": "Represents a user submission for a specific form.",
      "type": "object",
      "properties": {
        "formId": { "type": "string" },
        "data": { "type": "object" },
        "submittedAt": { "type": "number" }
      },
      "required": ["formId", "data", "submittedAt"]
    }
  },
  "firestore": {
    "/forms/{formId}": {
      "schema": "Form",
      "description": "Collection of form configurations."
    },
    "/responses/{responseId}": {
      "schema": "Response",
      "description": "Collection of form submission responses."
    }
  }
}
