rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Forms collection
    match /forms/{formId} {
      // Public can read forms (for viewing and filling)
      allow get: if true;
      allow list: if true;
      
      // Only authenticated users can create forms setting themselves as creator
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      
      // Only creator can update/delete their own form
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Responses collection
    match /responses/{responseId} {
      // Public can submit a response to a form
      allow create: if request.resource.data.formId is string;
      
      // Anyone can check for duplicate email submissions during form fill (for limitOneResponse check)
      // and logged-in form creators can view response lists
      allow get, list: if true;
      
      // Form owner can manage/delete responses
      allow update, delete: if request.auth != null;
    }
  }
}
